{
  "openapi": "3.1.0",
  "info": { "title": "Sakuno Avalonia Headless Driver", "version": "1.0.0" },
  "paths": {
    "/v1/capabilities": { "get": { "responses": { "200": { "description": "Capabilities", "content": { "application/json": { "schema": { "type": "object", "required": ["hostVersion", "protocolVersion", "avaloniaVersion", "features"] } } } }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/v1/sessions": { "post": { "responses": { "200": { "description": "Session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } }, "401": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/sessions/{sessionId}/snapshot": { "get": { "parameters": [{ "$ref": "#/components/parameters/SessionId" }, { "name": "windowId", "in": "query", "schema": { "type": "string" } }, { "name": "subtreePath", "in": "query", "schema": { "type": "string" } }, { "name": "maxDepth", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 32 } }, { "name": "maxNodes", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 10000 } }], "responses": { "200": { "description": "Snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Snapshot" } } } }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "410": { "$ref": "#/components/responses/Error" } } } },
    "/v1/sessions/{sessionId}/query": { "post": { "parameters": [{ "$ref": "#/components/parameters/SessionId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ElementQuery" } } } }, "responses": { "200": { "description": "Matches", "content": { "application/json": { "schema": { "type": "object", "required": ["snapshotId", "matches"], "properties": { "snapshotId": { "type": "integer" }, "matches": { "type": "array", "items": { "$ref": "#/components/schemas/SemanticNode" } } } } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/sessions/{sessionId}/actions": { "post": { "parameters": [{ "$ref": "#/components/parameters/SessionId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Action" } } } }, "responses": { "200": { "description": "Input executed", "content": { "application/json": { "schema": { "type": "object", "required": ["beforeObservationId", "afterObservationId", "target", "inputExecuted", "uiQueueProcessed"] } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "408": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } },
    "/v1/sessions/{sessionId}/wait": { "post": { "parameters": [{ "$ref": "#/components/parameters/SessionId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Wait" } } } }, "responses": { "200": { "description": "Condition matched", "content": { "application/json": { "schema": { "type": "object", "required": ["observationId", "matches"] } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "408": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/sessions/{sessionId}/windows/{windowId}/screenshot": { "get": { "parameters": [{ "$ref": "#/components/parameters/SessionId" }, { "name": "windowId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "PNG", "content": { "image/png": { "schema": { "type": "string", "format": "binary" } } } }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/v1/sessions/{sessionId}": { "delete": { "parameters": [{ "$ref": "#/components/parameters/SessionId" }], "responses": { "204": { "description": "Session closed; Host exits" }, "401": { "$ref": "#/components/responses/Error" }, "410": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer" } },
    "parameters": { "SessionId": { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } } },
    "responses": { "Error": { "description": "Stable error envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } },
    "schemas": {
      "Session": { "type": "object", "required": ["sessionId", "windows"], "properties": { "sessionId": { "type": "string" }, "windows": { "type": "array", "items": { "$ref": "#/components/schemas/Window" } } } },
      "Window": { "type": "object", "required": ["id", "title", "kind", "width", "height", "renderScaling"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "kind": { "type": "string" }, "width": { "type": "number" }, "height": { "type": "number" }, "renderScaling": { "type": "number" } } },
      "Bounds": { "type": "object", "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" } } },
      "SemanticNode": { "type": "object", "required": ["path", "controlType", "isVisible", "isEnabled", "isFocused", "children", "isTruncated"], "properties": { "path": { "type": "string" }, "controlType": { "type": "string" }, "name": { "type": ["string", "null"] }, "automationId": { "type": ["string", "null"] }, "role": { "type": ["string", "null"] }, "value": { "type": ["string", "null"] }, "isVisible": { "type": "boolean" }, "isEnabled": { "type": "boolean" }, "isFocused": { "type": "boolean" }, "isSelected": { "type": ["boolean", "null"] }, "isToggled": { "type": ["boolean", "null"] }, "bounds": { "$ref": "#/components/schemas/Bounds" }, "children": { "type": "array", "items": { "$ref": "#/components/schemas/SemanticNode" } }, "isTruncated": { "type": "boolean" } } },
      "Snapshot": { "type": "object", "required": ["snapshotId", "sessionId", "windows", "roots", "truncated"], "properties": { "snapshotId": { "type": "integer" }, "sessionId": { "type": "string" }, "windows": { "type": "array", "items": { "$ref": "#/components/schemas/Window" } }, "roots": { "type": "array", "items": { "$ref": "#/components/schemas/SemanticNode" } }, "truncated": { "type": "boolean" } } },
      "ElementQuery": { "type": "object", "additionalProperties": false, "properties": { "windowId": { "type": ["string", "null"] }, "automationId": { "type": ["string", "null"] }, "name": { "type": ["string", "null"] }, "nameMatch": { "type": "string", "enum": ["Exact", "Contains", "exact", "contains"] }, "text": { "type": ["string", "null"] }, "textMatch": { "type": "string", "enum": ["Exact", "Contains", "exact", "contains"] }, "role": { "type": ["string", "null"] }, "controlType": { "type": ["string", "null"] }, "includeHidden": { "type": "boolean" }, "subtreePath": { "type": ["string", "null"] } } },
      "Action": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string", "enum": ["click", "focus", "toggle", "select", "scroll", "text", "clear", "key", "pointer"] }, "query": { "$ref": "#/components/schemas/ElementQuery" }, "text": { "type": "string" }, "mode": { "type": "string", "enum": ["Replace", "Append", "replace", "append"] }, "windowId": { "type": "string" }, "key": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" } } },
      "Wait": { "type": "object", "required": ["query"], "properties": { "query": { "$ref": "#/components/schemas/ElementQuery" }, "property": { "type": "string", "enum": ["existence", "visibility", "enablement", "focus", "selection", "text", "value"] }, "comparison": { "type": "string", "enum": ["equals", "notEquals", "contains"] }, "expected": { "type": ["string", "null"] }, "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 } } },
      "Error": { "type": "object", "required": ["code", "message", "details", "diagnostics"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": {}, "diagnostics": { "type": "array", "items": { "type": "string" }, "maxItems": 10 } } }
    }
  },
  "security": [{ "bearer": [] }]
}
